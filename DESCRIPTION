Type: Package
Package: surveyresamplr
Title: Procedure for resampling historical groundfish survey data to
    understand relationships between survey effort and stock assessment
    uncertainty
Version: 0.0.1
Authors@R: c(
    person("Emily", "Markowitz", , "Emily.Markowitz@noaa.gov", role = c("aut", "cre"),
           comment = c(ORCID = "0000-0001-5757-4230")),
